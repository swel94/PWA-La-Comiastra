# Copia a `.env.local` y completa los valores (no subir `.env.local` al repo).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Se usan SOLO en Edge Functions (supabase secrets set), no en el cliente:
# SUPABASE_SERVICE_ROLE_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# RESEND_API_KEY=
# WEBHOOK_SECRET=
# CALENDAR_SYNC_URL=
# NOTIFY_URL=
